# Interner Mini-Proxy des Emi-Stacks.
#
# Er lauscht auf Port 80 und teilt EINE Domain auf zwei Dienste auf:
#   /admin*  und  /api/*  → CMS (Login, Daten-API, Bilder)
#   alles andere          → Astro-Frontend
#
# Nach AUSSEN bleibt der Stack damit „ein Upstream auf Port 80" – genau das
# Muster, das dein Multi-Tenant-Caddy per Label erwartet
# (caddy.reverse_proxy: "{{upstreams 80}}").
#
# WICHTIG: Upstreams werden über EINDEUTIGE Netz-Aliase angesprochen
# (astro / payload), NICHT über die generischen Dienstnamen web/cms. Im
# geteilten `caddy`-Netz gäbe es sonst Namens-Kollisionen mit anderen Mandanten
# (deren Stacks heißen oft auch „web"/„cms"). Die Aliase existieren nur im
# internen Netz dieses Stacks.

:80 {
	encode zstd gzip

	# CMS-Bilder lange cachen. Payload setzt selbst KEIN Cache-Control, dadurch
	# lud der Browser die Bilder bei jeder Navigation neu (fühlte sich zäh an).
	# 30 Tage ist für ein selten geändertes Portfolio ein guter Kompromiss.
	@media path /api/media/file/*
	handle @media {
		header Cache-Control "public, max-age=2592000"
		reverse_proxy payload:3001
	}

	# CMS (Payload/Next.js): Admin, Daten-API UND die Next-Assets.
	# Wichtig: /_next/* gehört zum CMS (Astro nutzt /_astro/, kollidiert also nicht).
	# Ohne /_next/* lädt das Admin-JavaScript nicht → weiße Seite.
	@cms path /admin* /api/* /_next/*
	handle @cms {
		reverse_proxy payload:3001
	}

	handle {
		reverse_proxy astro:4321
	}
}
