---
/**
 * Drop-in-Ersatz für Astros <Image> bei CMS-Bildern.
 * Rendert ein <img> mit srcset aus den im CMS erzeugten Größen – gleiche
 * Klassen, Styles und sizes wie zuvor, also optisch identisch. Layout-Sprünge
 * vermeidet width/height aus dem Bild. Zusätzliche Attribute (style,
 * loading, fetchpriority, data-parallax …) werden durchgereicht.
 */
import type { CmsBild } from '../lib/cms';

interface Props {
  bild: CmsBild;
  alt?: string;
  class?: string;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  decoding?: 'async' | 'sync' | 'auto';
  [key: string]: any;
}

// Standardmäßig verzögert laden — wie bei Astros <Image>. Ohne das lud die
// Seite ALLE Bilder sofort (auf den Case-Seiten bis zu neun Stück à 2000 px)
// und stellte damit alles andere hinten an, insbesondere das Video im
// Streifen. Hero-Bilder setzen bewusst loading="eager".
const {
  bild,
  alt,
  class: klasse,
  sizes,
  loading = 'lazy',
  decoding = 'async',
  ...rest
} = Astro.props;
---

<img
  src={bild.src}
  srcset={bild.srcset}
  sizes={sizes}
  width={bild.width}
  height={bild.height}
  alt={alt ?? bild.alt}
  class={klasse}
  loading={loading}
  decoding={decoding}
  {...rest}
/>
