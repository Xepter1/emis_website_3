---
/**
 * CMSVIDEO — Bewegtbild im Eindrucks-Streifen der Projektseiten.
 *
 * Bewusst ohne jede Bedienung:
 *  • Läuft stumm in Endlosschleife, ohne Knöpfe, ohne Browser-Bedienleiste.
 *  • Startet erst, wenn das Element beim Scrollen sichtbar wird — nie beim
 *    Laden der Seite. Außerhalb des Sichtfelds pausiert es (spart Akku, für
 *    den Blick unsichtbar).
 *  • „Bewegung reduzieren" (prefers-reduced-motion): nur das Standbild, es
 *    läuft nichts.
 *
 * Hinweis: Blockiert ein Browser das automatische Abspielen (Safari-Einstellung
 * „Automatische Wiedergabe", Stromsparmodus), bleibt das Standbild stehen —
 * ohne Knopf gibt es dann keinen Weg, das Video zu starten. So gewünscht.
 */
interface Props {
  src: string;
  poster?: string;
  /** Beschreibt den Inhalt für Screenreader, z. B. „VeloDynamics — Brandbook". */
  label: string;
  class?: string;
}

const { src, poster, label, class: klasse } = Astro.props;
---

<div class:list={['cmsvideo', klasse]} data-cmsvideo data-zustand="ruht">
  <video
    class="cmsvideo__el"
    poster={poster}
    muted
    playsinline
    loop
    preload="metadata"
    aria-label={label}
  >
    <source src={src} type="video/mp4" />
  </video>

  {
    /* Das Standbild als echtes Bild darüber — NICHT nur als poster-Attribut.
       Safari zeigt `poster` bei preload="none" nicht zuverlässig an; dort bliebe
       sonst eine leere Fläche stehen, während Chrome das Bild malt. */
    poster && (
      <img class="cmsvideo__standbild" src={poster} alt="" aria-hidden="true" />
    )
  }
</div>

<style>
  .cmsvideo {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: color-mix(in oklab, var(--welt-tinte) 8%, var(--welt-papier));
  }
  .cmsvideo__el {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Liegt deckungsgleich über dem Video und weicht, sobald es einmal läuft.
     Danach bleibt es weg — auch wenn der Browser zwischendurch anhält, sonst
     würde bei jedem Tabwechsel das Bild zurückspringen. */
  .cmsvideo__standbild {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cmsvideo[data-zustand='laeuft'] .cmsvideo__standbild {
    display: none;
  }
</style>

<script>
  // Steuerung der Streifen-Videos. Läuft bei jedem Seitenaufbau neu, also
  // auch nach View Transitions.
  function initCmsVideos() {
    const ruhig = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll<HTMLElement>('[data-cmsvideo]').forEach((box) => {
      if (box.dataset.bereit === '1') return; // schon verkabelt
      box.dataset.bereit = '1';

      const video = box.querySelector('video') as HTMLVideoElement | null;
      if (!video) return;

      // Tonspur gibt es nicht; stumm ist zusätzlich die Bedingung dafür, dass
      // Browser das Abspielen ohne Klick überhaupt erlauben.
      video.muted = true;

      // Bewegung reduzieren: es bleibt beim Standbild.
      if (ruhig) return;

      // Sobald das Video einmal läuft, weicht das Standbild dauerhaft.
      video.addEventListener('play', () => {
        box.dataset.zustand = 'laeuft';
      });

      const abspielen = () => video.play().catch(() => {});

      if (!('IntersectionObserver' in window)) {
        abspielen();
        return;
      }

      const beobachter = new IntersectionObserver(
        (eintraege) => {
          for (const e of eintraege) {
            if (e.isIntersecting) abspielen();
            else if (!video.paused) video.pause();
          }
        },
        { threshold: 0.35 },
      );
      beobachter.observe(box);

      // Beim Seitenwechsel aufräumen (verhindert Beobachter-Leichen).
      document.addEventListener('astro:before-swap', () => beobachter.disconnect(), {
        once: true,
      });
    });
  }

  document.addEventListener('astro:page-load', initCmsVideos);
</script>
