---
/**
 * NAV — Teil des heiligen Rahmens. Identisch auf jeder Seite, jeder Projektwelt.
 * Minimal: die Marke links, eine knappe Navigation rechts. Immer Galerie-Weiß.
 * Der Besucher fühlt sich nie verloren, egal wie wild die Welt darunter ist.
 */
const pfad = Astro.url.pathname;
const istAktiv = (href: string) =>
  href === "/" ? pfad === "/" : pfad.startsWith(href);

const punkte = [
  { href: "/", label: "Projekte" },
  { href: "/ueber", label: "Über mich" },
  { href: "/kontakt", label: "Kontakt" },
];
---

<header class="rahmen-nav" transition:persist="rahmen-nav">
  <div class="rahmen-nav__inner huelle-weit">
    <a href="/" class="marke" aria-label="EMS Design, zur Startseite">
      <span class="marke__logo" aria-hidden="true"></span>
    </a>

    <nav class="rahmen-nav__links" aria-label="Hauptnavigation">
      {
        punkte.map((p) => (
          <a
            href={p.href}
            class:list={["navlink", { "navlink--aktiv": istAktiv(p.href) }]}
            aria-current={istAktiv(p.href) ? "page" : undefined}
          >
            {p.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .rahmen-nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    height: var(--nav-h);
    background: color-mix(in oklab, var(--color-papier) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.1);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
    border-bottom: 1px solid var(--color-linie-zart);
  }

  .rahmen-nav__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  /* — Marke: das ganze Logo (per Maske in Tinte eingefärbt, gestochen scharf) — */
  .marke {
    display: inline-flex;
    align-items: center;
    color: var(--color-tinte);
  }
  .marke__logo {
    width: clamp(6.6rem, 15vw, 8.4rem);
    aspect-ratio: 1907 / 469;
    background: currentColor;
    -webkit-mask: url("/brand/emi-logo.png") left center / contain no-repeat;
    mask: url("/brand/emi-logo.png") left center / contain no-repeat;
    transition: transform 0.6s var(--ease-ruhig);
    transform-origin: left center;
  }
  .marke:hover .marke__logo {
    transform: scale(1.03);
  }

  /* — Navigationspunkte — */
  .rahmen-nav__links {
    display: flex;
    align-items: center;
    gap: clamp(1.1rem, 2.5vw, 2.4rem);
  }
  .navlink {
    position: relative;
    font-size: var(--text-klein);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-tinte-weich);
    transition: color 0.4s var(--ease-ruhig);
  }
  .navlink::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -0.4em;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease-ruhig);
  }
  .navlink:hover {
    color: var(--color-tinte);
  }
  .navlink:hover::after,
  .navlink--aktiv::after {
    transform: scaleX(1);
  }
  .navlink--aktiv {
    color: var(--color-tinte);
  }
</style>

<script>
  // Die Nav persistiert über View Transitions (transition:persist) und wird
  // dabei NICHT neu gerendert — die serverseitig gesetzte Markierung bliebe
  // sonst auf der zuvor besuchten Seite stehen. Darum nach jedem Seitenaufbau
  // den aktiven Punkt anhand des aktuellen Pfads neu bestimmen.
  function markiereAktivenPunkt() {
    const pfad = location.pathname;
    const istAktiv = (href: string) =>
      href === "/" ? pfad === "/" : pfad.startsWith(href);
    document
      .querySelectorAll<HTMLAnchorElement>(".rahmen-nav .navlink")
      .forEach((a) => {
        const aktiv = istAktiv(new URL(a.href).pathname);
        a.classList.toggle("navlink--aktiv", aktiv);
        if (aktiv) a.setAttribute("aria-current", "page");
        else a.removeAttribute("aria-current");
      });
  }
  document.addEventListener("astro:page-load", markiereAktivenPunkt);
</script>
