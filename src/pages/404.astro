---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  titel="Nicht gefunden · Emi · Grafikdesignerin"
  beschreibung="Diese Seite gibt es nicht."
>
  <section class="nf huelle">
    <p class="eyebrow nf__eyebrow" data-reveal>Fehler 404</p>
    <h1 class="nf__titel display-xl" data-reveal style="--reveal-delay:.06s">
      Hier ist nichts.
    </h1>
    <p class="nf__text lede" data-reveal style="--reveal-delay:.16s">
      Die Seite, die Sie suchen, gibt es nicht oder nicht mehr.
    </p>
    <a class="nf__link link-unterstrich" href="/" data-reveal style="--reveal-delay:.24s">
      Zurück zu den Projekten
    </a>
  </section>
</BaseLayout>

<style>
  .nf {
    min-height: 62vh;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 1.2rem;
    padding-block: clamp(4rem, 10vw, 9rem);
  }
  .nf__eyebrow {
    color: var(--color-taupe);
  }
  .nf__titel {
    margin: 0;
    max-width: 14ch;
  }
  .nf__text {
    color: var(--color-tinte-weich);
  }
  .nf__link {
    margin-top: 1rem;
    font-weight: 700;
    font-size: var(--text-lede);
  }
</style>
