---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";

// Kuratiert nach `reihenfolge`. Live-Projekte verlinken; „in-arbeit" sind
// ruhige Platzhalter-Slots.
const projekte = (await getCollection("projekte")).sort(
  (a, b) => a.data.reihenfolge - b.data.reihenfolge,
);

const nr = (i: number) => String(i + 1).padStart(2, "0");
---

<BaseLayout
  titel="Emi · Grafikdesignerin"
  beschreibung="Emi ist Grafikdesignerin mit Schwerpunkt Corporate Design. Markenidentitäten und Logos, die ruhig und sicher auftreten."
>
  <!-- ====================== HERO ====================== -->
  <section class="hero huelle">
    <p class="hero__eyebrow eyebrow" data-reveal>Grafikdesignerin</p>
    <h1 class="hero__logo" data-reveal style="--reveal-delay:.08s">
      <img
        src="/brand/emi-logo.png"
        alt="EMS Design, Grafikdesign von Emi"
        width="1907"
        height="469"
        fetchpriority="high"
      />
    </h1>
    <a class="hero__cue" href="#werke" data-reveal style="--reveal-delay:.28s">
      <span class="eyebrow">Projekte</span>
      <span class="hero__pfeil" aria-hidden="true"></span>
    </a>
  </section>

  <!-- ====================== WERKE ====================== -->
  <section id="werke" class="werke huelle" aria-label="Projekte">
    {
      projekte.map((p, i) => {
        const welt = p.data.welt;
        const weltVars = [
          `--w-papier:${welt.papier}`,
          `--w-tinte:${welt.tinte}`,
          `--w-akzent:${welt.akzent}`,
        ].join(";");

        if (p.data.status === "in-arbeit") {
          return (
            <div class="werk werk--leer" style={weltVars} data-reveal>
              <div class="werk__media werk__media--leer" aria-hidden="true">
                <span class="werk__leer-label eyebrow">In Arbeit</span>
              </div>
              <div class="werk__meta">
                <span class="werk__nr eyebrow ziffern-tab">{nr(i)}</span>
                <h2 class="werk__titel display">{p.data.titel}</h2>
                <p class="werk__diszi eyebrow">{p.data.disziplin.join("  ·  ")}</p>
                <p class="werk__text fliesstext">{p.data.kurzbeschreibung}</p>
              </div>
            </div>
          );
        }

        return (
          <a class="werk" href={`/projekte/${p.id}`} style={weltVars} data-reveal>
            <figure class="werk__media" transition:name={`cover-${p.id}`}>
              {p.data.cover && (
                <Image
                  src={p.data.cover}
                  alt={`${p.data.titel}, ${p.data.disziplin[0]}`}
                  widths={[480, 768, 1100, 1500]}
                  sizes="(max-width: 900px) 92vw, 56vw"
                  class="werk__bild"
                  style={`object-position:${p.data.coverFokus ?? "center"}`}
                />
              )}
            </figure>
            <div class="werk__meta">
              <span class="werk__nr eyebrow ziffern-tab">{nr(i)}</span>
              <h2 class="werk__titel display">{p.data.titel}</h2>
              <p class="werk__sub caption ziffern-tab">{p.data.jahr}</p>
              <p class="werk__diszi eyebrow">{p.data.disziplin.join("  ·  ")}</p>
              <p class="werk__text fliesstext">{p.data.kurzbeschreibung}</p>
              <span class="werk__cta">
                Projekt ansehen
                <span class="werk__cta-pfeil" aria-hidden="true" />
              </span>
            </div>
          </a>
        );
      })
    }
  </section>
</BaseLayout>

<style>
  /* ---------------- HERO ---------------- */
  .hero {
    padding-top: clamp(4rem, 3rem + 8vw, 9rem);
    padding-bottom: clamp(3rem, 2rem + 6vw, 7rem);
  }
  .hero__eyebrow {
    color: var(--color-taupe);
    margin-bottom: clamp(1.5rem, 4vw, 3rem);
  }
  /* Das ganze Logo, sehr groß — die Eröffnung der Seite. */
  .hero__logo {
    margin: 0;
    line-height: 0;
  }
  .hero__logo img {
    width: min(100%, 70rem);
    height: auto;
  }
  .hero__cue {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    color: var(--color-taupe);
    transition: color 0.4s var(--ease-ruhig);
  }
  .hero__cue:hover {
    color: var(--color-tinte);
  }
  .hero__pfeil {
    width: 1px;
    height: 2.4rem;
    background: currentColor;
    position: relative;
  }
  .hero__pfeil::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 6px;
    height: 6px;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: translateX(-50%) rotate(45deg);
  }

  /* ---------------- WERKE ---------------- */
  .werke {
    display: flex;
    flex-direction: column;
    gap: var(--raum-sektion);
    padding-top: var(--raum-block);
  }

  .werk {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
    color: var(--color-tinte);
  }
  /* Rhythmus: jedes zweite Werk spiegelt die Spalten. */
  .werk:nth-child(even) {
    grid-template-columns: 0.85fr 1.15fr;
  }
  .werk:nth-child(even) .werk__media {
    order: 2;
  }

  .werk__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 3px;
    background: color-mix(in oklab, var(--w-papier, var(--color-papier-tief)) 88%, #000 4%);
  }
  .werk__bild {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.01);
    transition: transform 1.1s var(--ease-ruhig);
  }
  .werk:hover .werk__bild {
    transform: scale(1.05);
  }

  /* Platzhalter-Medienfläche */
  .werk__media--leer {
    display: grid;
    place-items: center;
    background:
      repeating-linear-gradient(
        -45deg,
        transparent,
        transparent 11px,
        color-mix(in oklab, var(--w-tinte, #000) 6%, transparent) 11px,
        color-mix(in oklab, var(--w-tinte, #000) 6%, transparent) 12px
      ),
      var(--w-papier, var(--color-papier-tief));
  }
  .werk__leer-label {
    color: var(--w-tinte, var(--color-taupe));
    opacity: 0.7;
    padding: 0.5em 1em;
    border: 1px solid color-mix(in oklab, var(--w-tinte, #000) 30%, transparent);
    border-radius: 100px;
  }
  .werk--leer {
    opacity: 0.92;
  }
  .werk--leer .werk__titel {
    color: var(--color-tinte-weich);
  }

  .werk__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .werk__nr {
    color: var(--color-taupe);
    margin-bottom: 1.2rem;
  }
  .werk__titel {
    margin: 0 0 0.5rem;
    transition: color 0.4s var(--ease-ruhig);
  }
  .werk:hover .werk__titel {
    color: var(--w-akzent, var(--color-tinte));
  }
  .werk__sub {
    margin: 0 0 1rem;
  }
  .werk__diszi {
    color: var(--color-taupe);
    margin-bottom: 1.4rem;
  }
  .werk__text {
    color: var(--color-tinte-weich);
    margin: 0 0 1.6rem;
    max-width: 38ch;
  }
  .werk__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-size: var(--text-klein);
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .werk__cta-pfeil {
    width: 1.6rem;
    height: 1px;
    background: currentColor;
    position: relative;
    transition: width 0.4s var(--ease-ruhig);
  }
  .werk__cta-pfeil::after {
    content: "";
    position: absolute;
    right: 0;
    top: 50%;
    width: 6px;
    height: 6px;
    border-top: 1px solid currentColor;
    border-right: 1px solid currentColor;
    transform: translateY(-50%) rotate(45deg);
  }
  .werk:hover .werk__cta-pfeil {
    width: 2.6rem;
  }

  @media (max-width: 820px) {
    .werk,
    .werk:nth-child(even) {
      grid-template-columns: 1fr;
      gap: 1.4rem;
    }
    .werk:nth-child(even) .werk__media {
      order: 0;
    }
    .werk__media {
      aspect-ratio: 3 / 2;
    }
  }
</style>
