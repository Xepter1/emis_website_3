---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../site";

// Kontakt — direkt, einladend, ohne Hürde.
// Das Formular schickt die Anfrage per fetch (JSON) an den selbst gehosteten
// Kontakt-Dienst (gleiche Domain, Route /api/kontakt → contact-server/). Der
// validiert, mailt an Emi (Reply-To = Besucher) und schickt dem Absender eine
// automatische Eingangsbestätigung. Schlägt der Versand fehl, zeigt das
// Formular einen sichtbaren Fallback auf die E-Mail-Adresse.
const { email } = site;
---

<BaseLayout
  titel="Kontakt · Emi · Grafikdesignerin"
  beschreibung="Sprechen wir über Ihre Marke. Schreiben Sie Emi direkt: Corporate Design, Identitäten und Logos."
>
  <section class="kontakt huelle">
    <div class="kontakt__kopf">
      <p class="eyebrow kontakt__eyebrow" data-reveal>Kontakt</p>
      <h1 class="kontakt__titel display" data-reveal style="--reveal-delay:.05s">
        Erzähl mir<br />von deiner Vision.
      </h1>
    </div>

    <form class="kontakt__form" id="kontaktform" data-email={email} data-reveal style="--reveal-delay:.1s">
      <div class="feld">
        <label for="name" class="eyebrow">Name</label>
        <input id="name" name="name" type="text" autocomplete="name" required />
      </div>
      <div class="feld">
        <label for="email" class="eyebrow">E-Mail</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="feld">
        <label for="nachricht" class="eyebrow">Nachricht</label>
        <textarea id="nachricht" name="nachricht" rows="5" required></textarea>
      </div>

      <!-- Honeypot: für Menschen unsichtbar. Füllt ein Bot das Feld, wird die
           Anfrage serverseitig still verworfen. -->
      <div class="hp" aria-hidden="true">
        <label for="firma">Firma (bitte frei lassen)</label>
        <input id="firma" name="firma" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <button type="submit" class="kontakt__senden" id="kontaktsenden">
        <span class="kontakt__senden-text">Nachricht senden</span>
        <span class="kontakt__pfeil" aria-hidden="true"></span>
      </button>
      <p class="kontakt__status caption" id="kontaktstatus" role="status" aria-live="polite"></p>
    </form>
  </section>
</BaseLayout>

<style>
  .kontakt {
    padding-top: clamp(4rem, 3rem + 7vw, 8rem);
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }
  .kontakt__eyebrow {
    color: var(--color-taupe);
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }
  .kontakt__titel {
    margin: 0;
    max-width: 14ch;
  }
  .kontakt__lede {
    margin-top: clamp(1.5rem, 3vw, 2.2rem);
    color: var(--color-tinte-weich);
  }

  /* Formular — schlank, ruhig, Linien statt Kästen. */
  .kontakt__form {
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
    padding-top: 0.5rem;
  }
  .feld {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .feld label {
    color: var(--color-taupe);
  }
  .feld input,
  .feld textarea {
    font: inherit;
    color: var(--color-tinte);
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--color-linie);
    padding: 0.5rem 0;
    border-radius: 0;
    transition: border-color 0.4s var(--ease-ruhig);
    resize: vertical;
  }
  .feld input:focus,
  .feld textarea:focus {
    outline: none;
    border-bottom-color: var(--color-tinte);
  }
  .kontakt__senden {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 0.5rem;
    padding: 0.9rem 1.6rem;
    font: inherit;
    font-weight: 700;
    font-size: var(--text-klein);
    letter-spacing: 0.04em;
    color: var(--color-papier);
    background: var(--color-tinte);
    border: none;
    border-radius: 100px;
    cursor: pointer;
    transition: transform 0.4s var(--ease-ruhig), background-color 0.4s;
  }
  .kontakt__senden:hover {
    transform: translateY(-2px);
  }
  .kontakt__senden[disabled] {
    opacity: 0.55;
    cursor: progress;
    transform: none;
  }

  /* Honeypot: aus dem Blickfeld UND aus dem Accessibility-Baum genommen. */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .kontakt__pfeil {
    width: 1.4rem;
    height: 1px;
    background: currentColor;
    position: relative;
  }
  .kontakt__pfeil::after {
    content: "";
    position: absolute;
    right: 0;
    top: 50%;
    width: 5px;
    height: 5px;
    border-top: 1px solid currentColor;
    border-right: 1px solid currentColor;
    transform: translateY(-50%) rotate(45deg);
  }
  .kontakt__status {
    color: var(--color-taupe);
    min-height: 1.2em;
    margin: 0;
    transition: color 0.3s var(--ease-ruhig);
  }
  .kontakt__status[data-zustand="ok"] {
    color: var(--color-tinte);
  }
  .kontakt__status[data-zustand="fehler"] {
    color: var(--color-tinte);
  }
  .kontakt__status a {
    color: inherit;
    font-weight: 700;
    text-decoration: underline;
  }

  @media (max-width: 820px) {
    .kontakt {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Versand an den selbst gehosteten Kontakt-Dienst (gleiche Domain,
  // Route /api/kontakt). Hoistetes Modul-Skript + astro:page-load → bindet
  // zuverlässig auch nach View Transitions. Bei Fehler: sichtbarer mailto-
  // Fallback, damit keine Anfrage verloren geht.
  const ENDPOINT = "/api/kontakt";

  function bindKontakt() {
    const form = document.getElementById("kontaktform") as HTMLFormElement | null;
    if (!form || form.dataset.bound) return;
    form.dataset.bound = "1";

    const email = form.dataset.email ?? "";
    const btn = document.getElementById("kontaktsenden") as HTMLButtonElement | null;
    const btnText = form.querySelector<HTMLElement>(".kontakt__senden-text");
    const status = document.getElementById("kontaktstatus") as HTMLParagraphElement | null;

    const wert = (id: string) =>
      (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null)?.value.trim() ?? "";

    const setStatus = (text: string, zustand: "" | "ok" | "fehler" = "") => {
      if (!status) return;
      status.textContent = text;
      if (zustand) status.dataset.zustand = zustand;
      else delete status.dataset.zustand;
    };

    // Fallback: zeigt einen mailto-Link mit vorausgefüllter Nachricht, falls der
    // Dienst nicht erreichbar ist (z. B. lokal ohne Proxy, oder Mailserver down).
    const zeigeFallback = (name: string, text: string) => {
      if (!status) return;
      const betreff = `Anfrage von ${name || "der Website"}`;
      const koerper = `${text}\n\n${name}`;
      const href =
        `mailto:${email}?subject=${encodeURIComponent(betreff)}` +
        `&body=${encodeURIComponent(koerper)}`;
      status.dataset.zustand = "fehler";
      status.innerHTML =
        `Der Versand hat gerade nicht geklappt. Schreib mir direkt: ` +
        `<a href="${href}">${email}</a>`;
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const name = wert("name");
      const emailWert = wert("email");
      const text = wert("nachricht");
      const firma = wert("firma"); // Honeypot

      if (!name || !emailWert || !text) {
        setStatus("Bitte Name, E-Mail und Nachricht ausfüllen.", "fehler");
        return;
      }

      if (btn) btn.disabled = true;
      const original = btnText?.textContent ?? "Nachricht senden";
      if (btnText) btnText.textContent = "Wird gesendet …";
      setStatus("");

      try {
        const res = await fetch(ENDPOINT, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ name, email: emailWert, nachricht: text, firma }),
        });
        if (res.ok) {
          form.reset();
          setStatus(
            "Danke — deine Nachricht ist unterwegs. Du bekommst gleich eine Bestätigung per Mail.",
            "ok",
          );
        } else {
          zeigeFallback(name, text);
        }
      } catch {
        zeigeFallback(name, text);
      } finally {
        if (btn) btn.disabled = false;
        if (btnText) btnText.textContent = original;
      }
    });
  }
  document.addEventListener("astro:page-load", bindKontakt);
</script>
