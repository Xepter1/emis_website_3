---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../site";

// Kontakt — direkt, einladend, ohne Hürde. E-Mail steht im Vordergrund.
// Das schlanke Formular braucht kein Backend: es öffnet vorausgefüllt das
// Mailprogramm (funktioniert auf jedem statischen Hosting). Wer lieber
// serverseitig sammelt, kann es auf Netlify Forms / Formspree umstellen —
// siehe Kommentar im <script>.
const { email } = site;
---

<BaseLayout
  titel="Kontakt · Emi · Grafikdesignerin"
  beschreibung="Sprechen wir über Ihre Marke. Schreiben Sie Emi direkt: Corporate Design, Identitäten und Logos."
>
  <section class="kontakt huelle">
    <div class="kontakt__kopf">
      <p class="eyebrow kontakt__eyebrow" data-reveal>Kontakt</p>
      <h1 class="kontakt__titel display" data-reveal style="--reveal-delay:.05s">
        Erzähl mir<br />von deiner Vision.
      </h1>
    </div>

    <form class="kontakt__form" id="kontaktform" data-email={email} data-reveal style="--reveal-delay:.1s">
      <div class="feld">
        <label for="name" class="eyebrow">Name</label>
        <input id="name" name="name" type="text" autocomplete="name" required />
      </div>
      <div class="feld">
        <label for="nachricht" class="eyebrow">Nachricht</label>
        <textarea id="nachricht" name="nachricht" rows="5" required></textarea>
      </div>
      <button type="submit" class="kontakt__senden">
        Nachricht schreiben
        <span class="kontakt__pfeil" aria-hidden="true"></span>
      </button>
      <p class="kontakt__hinweis caption">
        Öffnet Ihr Mailprogramm mit vorausgefüllter Nachricht.
      </p>
    </form>
  </section>
</BaseLayout>

<style>
  .kontakt {
    padding-top: clamp(4rem, 3rem + 7vw, 8rem);
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }
  .kontakt__eyebrow {
    color: var(--color-taupe);
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }
  .kontakt__titel {
    margin: 0;
    max-width: 14ch;
  }
  .kontakt__lede {
    margin-top: clamp(1.5rem, 3vw, 2.2rem);
    color: var(--color-tinte-weich);
  }

  /* Formular — schlank, ruhig, Linien statt Kästen. */
  .kontakt__form {
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
    padding-top: 0.5rem;
  }
  .feld {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .feld label {
    color: var(--color-taupe);
  }
  .feld input,
  .feld textarea {
    font: inherit;
    color: var(--color-tinte);
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--color-linie);
    padding: 0.5rem 0;
    border-radius: 0;
    transition: border-color 0.4s var(--ease-ruhig);
    resize: vertical;
  }
  .feld input:focus,
  .feld textarea:focus {
    outline: none;
    border-bottom-color: var(--color-tinte);
  }
  .kontakt__senden {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 0.5rem;
    padding: 0.9rem 1.6rem;
    font: inherit;
    font-weight: 700;
    font-size: var(--text-klein);
    letter-spacing: 0.04em;
    color: var(--color-papier);
    background: var(--color-tinte);
    border: none;
    border-radius: 100px;
    cursor: pointer;
    transition: transform 0.4s var(--ease-ruhig), background-color 0.4s;
  }
  .kontakt__senden:hover {
    transform: translateY(-2px);
  }
  .kontakt__pfeil {
    width: 1.4rem;
    height: 1px;
    background: currentColor;
    position: relative;
  }
  .kontakt__pfeil::after {
    content: "";
    position: absolute;
    right: 0;
    top: 50%;
    width: 5px;
    height: 5px;
    border-top: 1px solid currentColor;
    border-right: 1px solid currentColor;
    transform: translateY(-50%) rotate(45deg);
  }
  .kontakt__hinweis {
    color: var(--color-taupe);
  }

  @media (max-width: 820px) {
    .kontakt {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Mailto-Komposition — kein Backend nötig, funktioniert überall.
  // Alternative für serverseitiges Sammeln: dem <form> `data-netlify="true"`
  // + ein verstecktes form-name-Feld geben (Netlify) oder action auf eine
  // Formspree-URL setzen und diesen Handler entfernen.
  // Hoistetes Modul-Skript + astro:page-load → bindet zuverlässig auch nach
  // View Transitions. E-Mail kommt aus data-email (kein define:vars nötig).
  function bindKontakt() {
    const form = document.getElementById("kontaktform") as HTMLFormElement | null;
    if (!form || form.dataset.bound) return;
    form.dataset.bound = "1";
    const email = form.dataset.email ?? "";
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const wert = (id: string) =>
        (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement)?.value.trim() ?? "";
      const name = wert("name");
      const text = wert("nachricht");
      const betreff = `Anfrage von ${name || "der Website"}`;
      const koerper = `${text}\n\n${name}`;
      window.location.href =
        `mailto:${email}?subject=${encodeURIComponent(betreff)}` +
        `&body=${encodeURIComponent(koerper)}`;
    });
  }
  document.addEventListener("astro:page-load", bindKontakt);
</script>
