---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";

// Nur live-Projekte bekommen eine Case-Seite. „in-arbeit" bleibt Platzhalter,
// bis Emi status auf „live" setzt — dann erscheint diese Seite automatisch.
export async function getStaticPaths() {
  const live = (await getCollection("projekte"))
    .filter((p) => p.data.status === "live")
    .sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);

  return live.map((p, i) => {
    const naechstes = live[(i + 1) % live.length];
    return {
      params: { slug: p.id },
      props: {
        p,
        naechstes: { id: naechstes.id, titel: naechstes.data.titel },
      },
    };
  });
}

const { p, naechstes } = Astro.props;
const d = p.data;

// Farbwelt als sichtbares System — nur die Farben (ohne Namen/Hex).
const palette = [
  d.welt.papier,
  d.welt.tinte,
  d.welt.akzent,
  d.welt.sekundaer,
].filter(Boolean) as string[];

const ogBild = d.cover?.src;
---

<BaseLayout
  titel={`${d.titel} · ${d.disziplin[0]} · Emi`}
  beschreibung={d.kurzbeschreibung}
  seitentyp="article"
  ogBild={ogBild}
  welt={d.welt}
>
  <article class="welt" data-stimmung={d.welt.stimmung}>
    <!-- ============== HERO (morpht aus der Übersicht) ============== -->
    {
      d.heroSeiten ? (
        // Triptychon: Cover in der Mitte (morpht), zwei Eindrücke links & rechts.
        <div class="case-hero-trio">
          <figure class="case-hero-trio__seite case-hero-trio__seite--links" data-reveal>
            <Image
              src={d.heroSeiten[0]}
              alt={`${d.titel} — Eindruck`}
              widths={[400, 600, 900]}
              sizes="(max-width: 820px) 48vw, 28vw"
              class="case-hero-trio__bild"
            />
          </figure>
          <figure class="case-hero-trio__mitte" transition:name={`cover-${p.id}`}>
            {d.cover && (
              <Image
                src={d.cover}
                alt={`${d.titel}, ${d.disziplin[0]}`}
                widths={[600, 900, 1300, 1700]}
                sizes="(max-width: 820px) 100vw, 44vw"
                class="case-hero-trio__bild"
                style={`object-position:${d.coverFokus ?? "center"}`}
                loading="eager"
                fetchpriority="high"
              />
            )}
          </figure>
          <figure
            class="case-hero-trio__seite case-hero-trio__seite--rechts"
            data-reveal
            style="--reveal-delay:.1s"
          >
            <Image
              src={d.heroSeiten[1]}
              alt={`${d.titel} — Eindruck`}
              widths={[400, 600, 900]}
              sizes="(max-width: 820px) 48vw, 28vw"
              class="case-hero-trio__bild"
            />
          </figure>
        </div>
      ) : (
        <figure class="case-hero" transition:name={`cover-${p.id}`}>
          {d.cover && (
            <Image
              src={d.cover}
              alt={`${d.titel}, ${d.disziplin[0]}`}
              widths={[768, 1200, 1800, 2400]}
              sizes="100vw"
              class="case-hero__bild"
              style={`object-position:${d.coverFokus ?? "center"}`}
              data-parallax
              loading="eager"
              fetchpriority="high"
            />
          )}
        </figure>
      )
    }

    <!-- ============== KOPF ============== -->
    <header class="case-kopf huelle">
      <a href="/" class="case-zurueck" data-reveal>
        <span class="case-zurueck__pfeil" aria-hidden="true"></span>
        Übersicht
      </a>
      <p class="case-kopf__diszi eyebrow" data-reveal>
        {d.disziplin.join("  ·  ")}
      </p>
      <h1 class="case-kopf__titel display-xl" data-reveal style="--reveal-delay:.06s">
        {d.titel}
      </h1>
      {
        d.einleitung && (
          <p class="case-kopf__lede lede" data-reveal style="--reveal-delay:.16s">
            {d.einleitung}
          </p>
        )
      }
    </header>

    <!-- ============== META + FARBWELT ============== -->
    <section class="case-meta huelle" data-reveal aria-label="Projektdaten">
      <dl class="case-meta__grid">
        {
          d.kunde && (
            <div class="case-meta__zelle">
              <dt class="eyebrow">Kunde</dt>
              <dd>{d.kunde}</dd>
            </div>
          )
        }
        <div class="case-meta__zelle">
          <dt class="eyebrow">Jahr</dt>
          <dd class="ziffern-tab">{d.jahr}</dd>
        </div>
        {
          d.leistung && d.leistung.length > 0 && (
            <div class="case-meta__zelle case-meta__zelle--breit">
              <dt class="eyebrow">Leistung</dt>
              <dd>{d.leistung.join(", ")}</dd>
            </div>
          )
        }
      </dl>

      {
        d.aufgabe && (
          <div class="case-meta__aufgabe">
            <p class="eyebrow">Über das Projekt</p>
            <p class="fliesstext">{d.aufgabe}</p>
          </div>
        )
      }

      <div class="case-palette" aria-label="Farbpalette">
        <p class="case-palette__label eyebrow">Farbpalette</p>
        <div class="case-palette__reihe">
          {
            palette.map((wert) => (
              <span class="case-palette__feld" style={`background:${wert}`} />
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============== ABSCHNITTE (Erzählung statt Galerie) ============== -->
    <div class="case-abschnitte">
      {
        d.abschnitte.map((a) => {
          switch (a.layout) {
            case "text":
              return (
                <section class="block-text huelle" data-reveal>
                  {a.ueberschrift && <h2 class="block-text__h titel">{a.ueberschrift}</h2>}
                  <p class="block-text__p fliesstext">{a.text}</p>
                </section>
              );
            case "zitat":
              return (
                <section class="block-zitat huelle" data-reveal>
                  <blockquote class="block-zitat__q">{a.zitat}</blockquote>
                  {a.quelle && <p class="block-zitat__quelle eyebrow">{a.quelle}</p>}
                </section>
              );
            case "breit":
              return (
                <figure class="block-breit huelle" data-reveal>
                  <Image
                    src={a.bild}
                    alt={a.bildunterschrift ?? d.titel}
                    widths={[600, 900, 1300, 1700]}
                    sizes="(max-width: 1000px) 92vw, 72vw"
                    class="block-breit__bild"
                  />
                  {a.bildunterschrift && (
                    <figcaption class="caption">{a.bildunterschrift}</figcaption>
                  )}
                </figure>
              );
            case "voll":
              return (
                <figure class:list={["block-voll", { "block-voll--hoch": a.hoch }]} data-reveal>
                  <div class="block-voll__rahmen">
                    <Image
                      src={a.bild}
                      alt={a.bildunterschrift ?? d.titel}
                      widths={[900, 1400, 2000, 2600]}
                      sizes="100vw"
                      class="block-voll__bild"
                      {...(a.hoch ? {} : { "data-parallax": true })}
                    />
                  </div>
                  {a.bildunterschrift && (
                    <figcaption class="caption huelle">{a.bildunterschrift}</figcaption>
                  )}
                </figure>
              );
            case "duo":
              return (
                <figure class="block-duo huelle" data-reveal>
                  <div class="block-duo__grid">
                    {a.bilder.map((b) => (
                      <Image
                        src={b}
                        alt={a.bildunterschrift ?? d.titel}
                        widths={[500, 800, 1100]}
                        sizes="(max-width: 820px) 92vw, 38vw"
                        class="block-duo__bild"
                      />
                    ))}
                  </div>
                  {a.bildunterschrift && (
                    <figcaption class="caption">{a.bildunterschrift}</figcaption>
                  )}
                </figure>
              );
          }
        })
      }
    </div>

    <!-- ============== RÜCKSPRUNG (Rahmen übernimmt wieder) ============== -->
    <nav class="case-naechstes huelle" aria-label="Weiter" data-reveal>
      <a href={`/projekte/${naechstes.id}`} class="case-naechstes__link">
        <span class="eyebrow">Nächstes Projekt</span>
        <span class="case-naechstes__titel display">{naechstes.titel}</span>
      </a>
      <a href="/" class="case-naechstes__alle link-unterstrich">Alle Projekte</a>
    </nav>
  </article>
</BaseLayout>

<style>
  /* Die Welt: füllt die Inhaltsfläche mit ihren eigenen Farben.
     Nav (oben) und Footer (unten) bleiben Galerie-Weiß = der Rahmen. */
  .welt {
    background: var(--welt-papier);
    color: var(--welt-tinte);
    /* zieht über den vollen Inhaltsbereich */
    padding-bottom: var(--raum-sektion);
  }

  /* ---------- HERO ---------- */
  .case-hero {
    margin: 0;
    width: 100%;
    height: clamp(56vh, 50vh + 14vw, 82vh);
    overflow: hidden;
    background: color-mix(in oklab, var(--welt-tinte) 8%, var(--welt-papier));
  }
  .case-hero__bild {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- HERO-TRIPTYCHON (Cover Mitte, Eindrücke links & rechts) ---------- */
  .case-hero-trio {
    display: grid;
    grid-template-columns: 1fr 1.5fr 1fr;
    grid-template-areas: "links mitte rechts";
    gap: clamp(0.5rem, 1.4vw, 1.1rem);
    height: clamp(46vh, 40vh + 11vw, 68vh);
    background: color-mix(in oklab, var(--welt-tinte) 8%, var(--welt-papier));
  }
  .case-hero-trio figure {
    margin: 0;
    overflow: hidden;
    background: color-mix(in oklab, var(--welt-tinte) 8%, var(--welt-papier));
  }
  .case-hero-trio__seite--links {
    grid-area: links;
  }
  .case-hero-trio__mitte {
    grid-area: mitte;
  }
  .case-hero-trio__seite--rechts {
    grid-area: rechts;
  }
  .case-hero-trio__bild {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Seitenbilder vollständig zeigen (nicht beschneiden) — wie gerahmte Tafeln
     im Passepartout. Die Mitte bleibt formatfüllend (sauberer Morph). */
  .case-hero-trio__seite .case-hero-trio__bild {
    object-fit: contain;
  }

  @media (max-width: 820px) {
    .case-hero-trio {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        "mitte mitte"
        "links rechts";
      height: auto;
      gap: 0.5rem;
    }
    .case-hero-trio__mitte {
      aspect-ratio: 4 / 3;
    }
    .case-hero-trio__seite {
      aspect-ratio: 3 / 4;
    }
  }

  /* ---------- KOPF ---------- */
  .case-kopf {
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
  }
  .case-zurueck {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--text-klein);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--welt-sekundaer, var(--welt-tinte));
    margin-bottom: clamp(2rem, 4vw, 3rem);
    transition: gap 0.4s var(--ease-ruhig), color 0.4s var(--ease-ruhig);
  }
  .case-zurueck:hover {
    gap: 1rem;
    color: var(--welt-tinte);
  }
  .case-zurueck__pfeil {
    width: 1.6rem;
    height: 1px;
    background: currentColor;
    position: relative;
  }
  .case-zurueck__pfeil::after {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 6px;
    height: 6px;
    border-left: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: translateY(-50%) rotate(45deg);
  }
  .case-kopf__diszi {
    color: var(--welt-akzent);
    margin-bottom: 1.2rem;
  }
  .case-kopf__titel {
    margin: 0;
    max-width: 14ch;
  }
  .case-kopf__lede {
    margin-top: clamp(1.4rem, 3vw, 2.2rem);
    color: color-mix(in oklab, var(--welt-tinte) 78%, transparent);
    max-width: 34ch;
  }

  /* ---------- META + FARBWELT ---------- */
  .case-meta {
    padding-top: clamp(3rem, 6vw, 5.5rem);
    padding-bottom: clamp(1rem, 3vw, 2rem);
  }
  .case-meta__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 1.6rem 2rem;
    margin: 0 0 clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--welt-linie);
  }
  .case-meta__zelle--breit {
    grid-column: span 2;
  }
  .case-meta__grid dt {
    color: var(--welt-sekundaer, var(--welt-tinte));
    margin-bottom: 0.6rem;
  }
  .case-meta__grid dd {
    margin: 0;
    font-size: var(--text-lede);
    line-height: 1.3;
  }
  .case-meta__aufgabe {
    display: grid;
    grid-template-columns: minmax(8rem, 1fr) 3fr;
    gap: 1.5rem 2rem;
    align-items: start;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .case-meta__aufgabe .eyebrow {
    color: var(--welt-sekundaer, var(--welt-tinte));
    padding-top: 0.4em;
  }
  .case-meta__aufgabe .fliesstext {
    color: color-mix(in oklab, var(--welt-tinte) 86%, transparent);
  }

  .case-palette__label {
    color: var(--welt-sekundaer, var(--welt-tinte));
    margin-bottom: clamp(1rem, 2.5vw, 1.6rem);
  }
  .case-palette__reihe {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.8rem, 2vw, 1.4rem);
  }
  .case-palette__feld {
    width: clamp(3.25rem, 7vw, 5rem);
    height: clamp(3.25rem, 7vw, 5rem);
    border-radius: 50%;
    border: 1px solid var(--welt-linie);
  }

  /* ---------- ABSCHNITTE ---------- */
  .case-abschnitte {
    display: flex;
    flex-direction: column;
    gap: var(--raum-sektion);
    padding-top: var(--raum-sektion);
  }

  .block-text {
    display: grid;
    justify-content: center;
  }
  .block-text__h {
    margin: 0 0 1.2rem;
    color: var(--welt-akzent);
  }
  .block-text__p {
    color: color-mix(in oklab, var(--welt-tinte) 88%, transparent);
    font-size: var(--text-lede);
    line-height: 1.5;
    max-width: 34ch;
    /* keine Silbentrennung bei großem Erzähltext — bleibt ruhig statt zerhackt */
    hyphens: manual;
  }

  .block-zitat {
    text-align: center;
    padding-block: clamp(1rem, 3vw, 3rem);
  }
  .block-zitat__q {
    margin: 0 auto;
    max-width: 22ch;
    font-size: var(--text-display);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .block-zitat__quelle {
    margin-top: 1.6rem;
    color: var(--welt-sekundaer, var(--welt-tinte));
  }

  .block-breit__bild {
    width: 100%;
    height: auto;
    border-radius: 3px;
  }
  .block-breit figcaption,
  .block-duo figcaption {
    margin-top: 1rem;
  }

  .block-voll {
    margin: 0;
  }
  .block-voll__rahmen {
    width: 100%;
    height: clamp(60vh, 50vh + 16vw, 88vh);
    overflow: hidden;
  }
  .block-voll--hoch .block-voll__rahmen {
    /* Definite Höhe (nicht auto) — sonst kollabiert/überläuft der Rahmen,
       weil das Bild darin height:100% nutzt. */
    height: clamp(60vh, 50vh + 16vw, 88vh);
    max-height: 92vh;
  }
  .block-voll__bild {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .block-voll--hoch .block-voll__bild {
    /* Hochformat vollständig zeigen: ins Rahmenformat einpassen (zentriert,
       schmal) statt formatfüllend beschneiden. */
    object-fit: contain;
  }
  .block-voll figcaption {
    margin-top: 1rem;
  }

  .block-duo__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1rem, 2.5vw, 2rem);
  }
  .block-duo__bild {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 3px;
  }

  /* ---------- RÜCKSPRUNG ---------- */
  .case-naechstes {
    margin-top: var(--raum-sektion);
    padding-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--welt-linie);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .case-naechstes__link {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    color: var(--welt-tinte);
    transition: opacity 0.4s var(--ease-ruhig);
  }
  .case-naechstes__link .eyebrow {
    color: var(--welt-sekundaer, var(--welt-tinte));
  }
  .case-naechstes__link:hover {
    opacity: 0.6;
  }
  .case-naechstes__alle {
    color: var(--welt-sekundaer, var(--welt-tinte));
    font-weight: 700;
    font-size: var(--text-klein);
    letter-spacing: 0.04em;
  }

  @media (max-width: 820px) {
    .case-meta__aufgabe {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }
    .case-meta__zelle--breit {
      grid-column: span 1;
    }
    .block-duo__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // GSAP-Parallax — die „feinere" In-Welt-Bewegung. Genau dosiert,
  // nur auf [data-parallax]. Respektiert prefers-reduced-motion und
  // räumt sich bei View Transitions sauber auf.
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  function initParallax() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    document.querySelectorAll<HTMLElement>("[data-parallax]").forEach((bild) => {
      const rahmen = bild.parentElement;
      if (!rahmen) return;
      gsap.set(bild, { scale: 1.16 });
      gsap.fromTo(
        bild,
        { yPercent: -7 },
        {
          yPercent: 7,
          ease: "none",
          scrollTrigger: {
            trigger: rahmen,
            start: "top bottom",
            end: "bottom top",
            scrub: true,
          },
        },
      );
    });
  }

  document.addEventListener("astro:page-load", initParallax);
  // Vor jedem Seitenwechsel die Trigger killen (verhindert Dubletten/Leaks).
  document.addEventListener("astro:before-swap", () => {
    ScrollTrigger.getAll().forEach((t) => t.kill());
  });
</script>
