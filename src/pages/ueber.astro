---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import emiFoto from "../assets/emi.jpg";

// Über mich — kurz, persönlich, sicher. Darunter der Werdegang (Lebenslauf).
// Reverse-chronologisch, ohne Firmennamen, ohne Beschreibungstexte: nur Zeit + Station.
const werdegang = [
  {
    zeit: "09/2025 – 05/2026",
    titel: "OfG – Lehrgang zur Grafikdesignerin",
  },
  {
    zeit: "09/2022 – 09/2025",
    titel: "Ausbildung & anschließende Tätigkeit als Gestalterin für visuelles Marketing",
  },
  {
    zeit: "09/2019 – 07/2021",
    titel: "Staatliche Fachoberschule Landshut",
  },
];
---

<BaseLayout
  titel="Über mich · Emi · Grafikdesignerin"
  beschreibung="Emi, Grafikdesignerin: ihr Weg vom visuellen Marketing zur Grafikdesignerin — und worauf sie im Design Wert legt."
>
  <section class="ueber huelle">
    <div class="ueber__grid">
      <figure class="ueber__foto">
        <Image
          src={emiFoto}
          alt="Emi, Grafikdesignerin"
          widths={[320, 480, 640, 786]}
          sizes="(max-width: 820px) 92vw, 36vw"
          class="ueber__foto-bild"
          loading="eager"
          fetchpriority="high"
        />
      </figure>

      <div class="ueber__text">
        <h1 class="ueber__titel display" data-reveal>Über mich</h1>
        <div class="ueber__intro" data-reveal style="--reveal-delay:.12s">
          <p class="fliesstext">
            Meine Leidenschaft für Design begleitet mich schon lange. Die Freude
            daran, zu kreieren, hat mich schließlich dazu gebracht, meine
            Ausbildung zur Gestalterin für visuelles Marketing zu beginnen.
          </p>
          <p class="fliesstext">
            Während dieser Zeit wurde mir schnell klar, dass mir besonders das
            Designen am Computer viel Spaß bereitet. Themen wie Plakatgestaltung,
            Logodesign und Corporate Identity haben meine größte Begeisterung
            geweckt. Inspiriert von Design-, Mode- und Trendwelten entwickle ich
            gerne Konzepte, die nicht nur gut aussehen, sondern auch eine klare
            visuelle Sprache sprechen.
          </p>
          <p class="fliesstext">
            Um meine kreative Leidenschaft weiter auszubauen und meinen eigenen
            Stil zu vertiefen, habe ich mich bewusst für eine Umschulung zur
            Grafikdesignerin entschieden.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="werdegang huelle" aria-label="Werdegang">
    <p class="eyebrow werdegang__label" data-reveal>Werdegang</p>
    <ol class="werdegang__liste">
      {
        werdegang.map((s, i) => (
          <li class="werdegang__item" data-reveal style={`--reveal-delay:${i * 0.06}s`}>
            <span class="werdegang__zeit eyebrow ziffern-tab">{s.zeit}</span>
            <h2 class="werdegang__titel">{s.titel}</h2>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="signatur huelle" data-reveal>
    <img
      class="signatur__bild"
      src="/brand/emi-signatur-dunkel.png"
      alt="Handschriftliche Unterschrift von Emi"
      width="220"
      height="92"
      loading="lazy"
    />
  </section>
</BaseLayout>

<style>
  /* Kopf: Foto links (oben bündig zur Navbar, unten abgerundet), Text rechts. */
  .ueber {
    /* kein oberer Abstand — das Foto schließt direkt an die Navbar an */
    padding-top: 0;
  }
  .ueber__grid {
    display: grid;
    /* Foto kompakt, Text füllt den Rest — bewusst breit. */
    grid-template-columns: minmax(190px, 330px) 1fr;
    gap: clamp(1.75rem, 5vw, 4.5rem);
    align-items: start;
  }
  .ueber__foto {
    margin: 0;
    /* Eine durchgehende Kurve von Ecke zu Ecke (eine elliptische Rundung
       über die ganze Breite), oben bündig zur Navbar. */
    border-radius: 0 0 50% 50% / 0 0 clamp(2.5rem, 10vw, 7rem) clamp(2.5rem, 10vw, 7rem);
    overflow: hidden;
    background: var(--color-papier-tief);
  }
  .ueber__foto-bild {
    width: 100%;
    height: auto;
    display: block;
  }
  .ueber__text {
    /* Überschrift atmet, während das Foto oben bündig bleibt */
    padding-top: clamp(2rem, 6vw, 5rem);
  }
  .ueber__titel {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0;
  }
  .ueber__intro {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    color: var(--color-tinte-weich);
    /* breit: füllt die Textspalte, gedeckelt nur für die Lesbarkeit */
    max-width: 68ch;
  }

  @media (max-width: 820px) {
    .ueber__grid {
      grid-template-columns: 1fr;
      gap: clamp(1.5rem, 5vw, 2.5rem);
    }
    .ueber__text {
      padding-top: 0.5rem;
    }
    .ueber__foto {
      /* Hochformat auf Mobil nicht zu hoch werden lassen */
      max-height: 72vh;
    }
    .ueber__foto-bild {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 18%;
    }
  }

  /* ---------- WERDEGANG (Lebenslauf) ---------- */
  .werdegang {
    margin-top: var(--raum-sektion);
    padding-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--color-linie);
  }
  .werdegang__label {
    color: var(--color-taupe);
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }
  .werdegang__liste {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .werdegang__item {
    display: grid;
    grid-template-columns: minmax(9rem, 13rem) 1fr;
    gap: 0.6rem 2.5rem;
    align-items: baseline;
    padding: clamp(1.4rem, 3vw, 2.2rem) 0;
    border-top: 1px solid var(--color-linie-zart);
    transition: gap 0.5s var(--ease-ruhig);
  }
  .werdegang__item:first-child {
    border-top: none;
  }
  .werdegang__zeit {
    color: var(--color-taupe);
    padding-top: 0.15em;
  }
  .werdegang__titel {
    margin: 0;
    max-width: 38ch;
    font-size: var(--text-lede);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.004em;
  }

  .signatur {
    margin-top: var(--raum-sektion);
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    align-items: flex-start;
  }
  .signatur__bild {
    width: clamp(170px, 22vw, 230px);
    height: auto;
    opacity: 0.9;
  }
</style>
